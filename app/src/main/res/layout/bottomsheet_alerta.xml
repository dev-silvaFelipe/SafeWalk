<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet de confirmação: Dark mode com glassmorphism -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Icone vetorial de informação -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_info"
        android:contentDescription="Informação"
        app:tint="@color/sw_accent" />

    <!-- Pergunta -->
    <TextView
        android:id="@+id/tvPergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="O problema ainda persiste?"
        android:textAlignment="center"
        android:textColor="@color/sw_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Descricao -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sua confirmação ajuda a manter o mapa atualizado para outros usuários."
        android:textAlignment="center"
        android:textColor="@color/sw_text_secondary"
        android:textSize="14sp" />

    <!-- Botao Confirmar: amarelo vibrante -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Sim, ainda existe"
        android:textAllCaps="false"
        android:textColor="@color/sw_text_on_accent"
        android:textStyle="bold"
        android:backgroundTint="@color/sw_accent"
        app:cornerRadius="16dp" />

    <!-- Botao Resolvido: outline com borda amarela -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResolvido"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Não, já foi resolvido"
        android:textAllCaps="false"
        android:textColor="@color/sw_text_primary"
        app:strokeColor="@color/sw_border"
        app:cornerRadius="16dp" />

</LinearLayout>
