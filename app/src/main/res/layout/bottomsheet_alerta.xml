<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet de confirmação / resolução: Dark mode -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/sw_border" />

    <!-- Icone vetorial de cabeçalho -->
    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_info"
        android:contentDescription="Informação"
        app:tint="@color/sw_accent" />

    <!-- Pergunta / Título -->
    <TextView
        android:id="@+id/tvPergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gerenciamento de Incidente"
        android:textAlignment="center"
        android:textColor="@color/sw_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitulo descritivo -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sua confirmação comunitária mantém o mapa atualizado para outros cidadãos."
        android:textAlignment="center"
        android:textColor="@color/sw_text_secondary"
        android:textSize="14sp" />

    <!-- Botao Confirmar: amarelo vibrante -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Sim, ainda existe"
        android:textAllCaps="false"
        android:textColor="@color/sw_text_on_accent"
        android:textStyle="bold"
        android:backgroundTint="@color/sw_accent"
        app:cornerRadius="16dp" />

    <!-- Botao Marcar como Resolvido (Exclusivo Prefeitura - visibility gerenciada em tempo de execução) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResolvido"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="Marcar como Resolvido"
        android:textAllCaps="false"
        android:textColor="@color/sw_text_primary"
        android:visibility="gone"
        app:strokeColor="@color/sw_border"
        app:icon="@drawable/ic_check"
        app:iconTint="@color/sw_text_primary"
        app:iconGravity="textStart"
        app:cornerRadius="16dp" />

</LinearLayout>
