<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment do Mapa: fundo escuro com mapa ocupando toda a tela -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sw_bg_primary">

    <!-- Mapa em tela cheia -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Caixa de legenda flutuante com marcadores codificados por cor -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_legend_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Legenda"
            android:textColor="@color/sw_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Postes apagados — vermelho -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/sw_marker_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Asfalto"
                android:textColor="@color/sw_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Calcadas — laranja -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/sw_marker_orange" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Esgoto"
                android:textColor="@color/sw_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Iluminação — amarelo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/sw_marker_yellow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Iluminação"
                android:textColor="@color/sw_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Areas de risco — roxo/magenta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/sw_marker_purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Vazamento"
                android:textColor="@color/sw_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
