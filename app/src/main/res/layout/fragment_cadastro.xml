<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de Cadastro: Dark mode com destaque amarelo -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sw_bg_primary"
    android:padding="24dp">

    <!-- Botao Voltar: ícone vetorial -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Voltar"
        app:tint="@color/sw_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Titulo -->
    <TextView
        android:id="@+id/tvTitleCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Criar Conta"
        android:textColor="@color/sw_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- Subtitulo -->
    <TextView
        android:id="@+id/tvSubtitleCadastro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Junte-se à nossa comunidade para reportar problemas de infraestrutura."
        android:textColor="@color/sw_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleCadastro" />

    <!-- Campo Nome -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlNome"
        style="@style/SafeWalk.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Nome Completo"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="@color/sw_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleCadastro">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sw_text_primary"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo Telefone -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlTelefone"
        style="@style/SafeWalk.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Telefone"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/sw_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tlNome">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sw_text_primary"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo Senha -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tlSenha"
        style="@style/SafeWalk.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Sua Senha"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/sw_text_secondary"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/sw_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tlTelefone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sw_text_primary"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botao de cadastro: amarelo vibrante -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCadastrar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:text="Finalizar Cadastro"
        android:textColor="@color/sw_text_on_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/sw_accent"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tlSenha" />

</androidx.constraintlayout.widget.ConstraintLayout>
