<?xml version="1.0" encoding="utf-8"?>
<!-- Seletor de cor para a borda do TextInputLayout:
     - Quando focado, usa o amarelo accent
     - Quando inativo, usa a cor de borda padrão -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/sw_accent" />
    <item android:state_hovered="true" android:color="@color/sw_text_secondary" />
    <item android:color="@color/sw_border" />
</selector>

